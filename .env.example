DATABASE_URL="mysql://user:password@localhost:3306/hbmp"
SERVER_URL="http://localhost:3001"
EXPORT_SERVER_URL="http://localhost:3002"
JWT_SECRET="your-jwt-secret-here"
NODE_ENV="development"

